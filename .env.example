# GitLab Configuration (Required)
GITLAB_URL=https://gitlab.com            # or your self-managed host
GITLAB_TOKEN=your-gitlab-personal-access-token
# GITLAB_DEFAULT_GROUP=my-group          # prepended to short project paths (team/repo -> my-group/team/repo)

# Jira (Optional) - story context via an Atlassian MCP connector in your Claude login
# JIRA_SITE=your-company.atlassian.net
# JIRA_PROJECT_KEYS=PAY,CORE             # only these keys count as tickets
# JIRA_MCP_TOOL=mcp__claude_ai_Atlassian__getJiraIssue

# Post one run-record note on the MR for every --dry-run (off by default)
# MR_REVIEWER_RECORD_RUNS=1

# Anthropic Configuration (Optional - only needed with --use-api flag)
# If not set, the tool uses Claude Code CLI by default
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Override model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
